#: cd9ce1464c4c4887bcbf01fe7d3fa2c8 of sds.graph.interfaces.AbstractGraph:1
msgid "Abstract base class for all graph implementations."
msgstr ""

#: f2f815747f764bdb892be6ba1e8dc227 of sds.graph.interfaces.AbstractGraph:3
msgid ""
"This class defines the core interface that all graph types must "
"implement. It extends Collection to provide common operations like size, "
"emptiness, and iteration."
msgstr ""

#: f8414105c27548399e42f4979bd1d507 of sds.graph.interfaces.AbstractGraph:7
msgid ""
"A graph consists of nodes (vertices) connected by edges. This abstract "
"class defines operations for managing both nodes and edges."
msgstr ""

#: 30e573866920488895953febf149facc of sds.graph.interfaces.AbstractGraph:10
msgid "Notes"
msgstr ""

#: cde3004fe89045e783615147f01ad5eb of sds.graph.interfaces.AbstractGraph:12
msgid ""
"Concrete implementations must provide: - Node management (add_node, "
"remove_node, has_node) - Edge management (add_edge, remove_edge, "
"has_edge) - Neighbor queries (neighbors, degree) - Traversal support "
"(nodes, edges) - Graph properties (is_connected, etc.)"
msgstr ""

