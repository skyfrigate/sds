#: 52f09c9a2ec4400f9fccea21504d0c1c of
#: sds.advanced.hash_table.HashTableOpenAddressing:1
msgid "Hash table using open addressing with linear probing."
msgstr ""

#: 20cb279e77de46718dd6f16948fa3a96 of
#: sds.advanced.hash_table.HashTableOpenAddressing:3
msgid ""
"All entries are stored directly in the primary array. On collision, the "
"algorithm probes subsequent slots (``index + 1``, ``index + 2``, …) until"
" an empty slot is found. Deleted slots are marked with a sentinel "
"(``_DELETED``) so that probing chains are not broken."
msgstr ""

#: 49767894538745afbc56d1c7a2f688c3 of
#: sds.advanced.hash_table.HashTableOpenAddressing:8
msgid ""
"Automatic resizing doubles the capacity when the load factor (including "
"tombstones) exceeds ``max_load_factor``."
msgstr ""

#: 47348f1b0fcd4fd6bdac9ad9d28f88ea of
#: sds.advanced.hash_table.HashTableOpenAddressing:11
msgid "Initial number of slots. Must be ≥ 2. Default is 16."
msgstr ""

#: c93c70fed0f34ebca5ba50566e6edb2c of
#: sds.advanced.hash_table.HashTableOpenAddressing:13
msgid "Resize threshold. Must be in (0.0, 1.0). Default is 0.6."
msgstr ""

#: be2197daa3e046a58c5b058899be8a76 of
#: sds.advanced.hash_table.HashTableOpenAddressing:24
msgid "Ratio of active entries to slots (read-only). Excludes tombstones."
msgstr ""

#: 35754c0ec67041ae97b735201c8fcf33 38aeb5a1f22b41ec822896accd54de1c of
#: sds.advanced.hash_table.HashTableOpenAddressing:28
#: sds.advanced.hash_table.HashTableOpenAddressing.__init__:8
msgid "If ``capacity < 2`` or ``max_load_factor`` not in (0, 1)."
msgstr ""

#: a72544a3a3854a14844573e6e6a17e1b of
#: sds.advanced.hash_table.HashTableOpenAddressing:46
msgid "Keys must be hashable and support ``==``."
msgstr ""

#: eaede48bee4c498cbf14449fc1ea2a62 of
#: sds.advanced.hash_table.HashTableOpenAddressing:47
msgid "Load factor must remain below 1.0 (enforced by max_load_factor < 1.0)."
msgstr ""

#: 1fc26b07d1c74fa79c515d231c432681 of
#: sds.advanced.hash_table.HashTableOpenAddressing:48
msgid ""
"Tombstones (``_DELETED``) accumulate after deletions; a resize clears "
"them by rehashing all live entries."
msgstr ""

#: 3b6f39b366884c50b3ceb3e52c8cacce of
#: sds.advanced.hash_table.HashTableOpenAddressing:50
msgid ""
"Linear probing suffers from *primary clustering*. For production use with"
" adversarial input, consider quadratic probing or double hashing."
msgstr ""

