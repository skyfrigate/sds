#: e49960ea2d35488d9060c462575488d1 of sds.advanced.skip_list.SkipList:1
msgid "Probabilistic sorted data structure with O(log n) expected operations."
msgstr ""

#: 0c11d83ac41e400dada85da6729548d6 of sds.advanced.skip_list.SkipList:3
msgid ""
"A skip list organises elements in a sorted base linked list while "
"maintaining express lanes at higher levels for fast traversal. Each node "
"is promoted to the next level with probability *p*, independently."
msgstr ""

