#: 3a52475433a5479a82797a27d76dab58 of
#: sds.advanced.interfaces.AbstractLRUCache:1
msgid "Abstract base class for a Least Recently Used (LRU) cache."
msgstr ""

#: 72d47b891a974efbb48b924c99a9c76d of
#: sds.advanced.interfaces.AbstractLRUCache:3
msgid ""
"An LRU cache stores a bounded number of key-value pairs. When the cache "
"is full and a new key must be inserted, the least recently used entry "
"(the one not accessed for the longest time) is evicted."
msgstr ""

#: 787f019501e3486fb04b0cac0d946cc1 of
#: sds.advanced.interfaces.AbstractLRUCache:7
msgid ""
"Every ``get`` and ``put`` operation counts as a \"use\" and moves the "
"accessed entry to the most-recently-used position."
msgstr ""

#: ff05e3ee79f84be9a00ee6bf6e495695 of
#: sds.advanced.interfaces.AbstractLRUCache:12
msgid ""
"The canonical implementation combines a doubly-linked list (for O(1) "
"eviction) with a hash map (for O(1) lookup), giving O(1) amortised time "
"for both ``get`` and ``put``."
msgstr ""

#: ed4d3e11edba40c882ef65795e37e625 of
#: sds.advanced.interfaces.AbstractLRUCache:18
msgid ":obj:`LRUCache`"
msgstr ""

#: 22a52a748dc749c48ef3ec2240e2d12e of
#: sds.advanced.interfaces.AbstractLRUCache.get:1
msgid "Return the value for *key* and mark it as most recently used."
msgstr ""

