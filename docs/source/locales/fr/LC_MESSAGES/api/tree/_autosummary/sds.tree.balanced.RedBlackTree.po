#: 95fb8d86d563453fa6dc32c04167e568 of sds.tree.balanced.RedBlackTree:1
msgid "Red-Black Tree - Self-balancing binary search tree."
msgstr ""

#: b1112be2b5334b53bf59ef4485d882f6 of sds.tree.balanced.RedBlackTree:3
msgid ""
"A Red-Black tree is a BST with one extra bit per node: color (RED or "
"BLACK). The tree maintains balance using the following properties:"
msgstr ""

#: a01f546ba51446e8898130f960b0d7ee of sds.tree.balanced.RedBlackTree:6
msgid "Every node is either RED or BLACK"
msgstr ""

#: 131da9a0edae4c64bd4c319e439d2fcf of sds.tree.balanced.RedBlackTree:7
msgid "The root is always BLACK"
msgstr ""

#: 6572216acfa64b82bdbf27cf0e3569a4 of sds.tree.balanced.RedBlackTree:8
msgid "All leaves (NIL) are BLACK"
msgstr ""

#: 5cf70f3a559f4a6fb4e9459576699fc9 of sds.tree.balanced.RedBlackTree:9
msgid "RED nodes cannot have RED children (no two RED nodes in a row)"
msgstr ""

#: 95cde80c89eb449ba9c477386efb9803 of sds.tree.balanced.RedBlackTree:10
msgid "Every path from root to leaf has the same number of BLACK nodes"
msgstr ""

#: 3334ddb3476147238b3996b9dd6ce401 of sds.tree.balanced.RedBlackTree:12
msgid ""
"These properties ensure the tree remains approximately balanced, "
"guaranteeing O(log n) operations."
msgstr ""

#: 3b88f44c73e84197b1a8267f9d2b3e28 of sds.tree.balanced.RedBlackTree:17
msgid "The root node of the tree."
msgstr ""

#: 1c260a3f14044b0d95501bc769db38e3 e71548de4af545e0842b13127e115990 of
#: sds.tree.balanced.RedBlackTree
msgid "type"
msgstr ""

#: 3716777e88aa4945833c233a8ce7a91f of sds.tree.balanced.RedBlackTree:19
msgid "RedBlackNode or None"
msgstr ""

#: 16c4755a84fa4266b3703f146cab7c58 of sds.tree.balanced.RedBlackTree:23
msgid "The number of nodes in the tree."
msgstr ""

#: a5dbbf5470314fcd8943c81ff9443c17 of sds.tree.balanced.RedBlackTree:25
msgid "int"
msgstr ""

