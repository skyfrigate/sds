#: 4c8f311c404d48c0af3aaeac6ee8f8df of sds.tree.balanced.AVLTree:3
msgid ""
"An AVL tree is a BST where the heights of the two child subtrees of any "
"node differ by at most one. If at any time they differ by more than one, "
"rebalancing is done through rotations to restore this property."
msgstr ""

#: 0258132448bf4999b9e5567e4b594ff4 of sds.tree.balanced.AVLTree:8
msgid ""
"Balance factor = height(left subtree) - height(right subtree) Valid "
"balance factors: -1, 0, 1"
msgstr ""

