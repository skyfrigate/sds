#: 63bcbffc06704304a5d4fea46ae03e1c of sds.tree.balanced.RedBlackTree:1
msgid "Red-Black Tree - Self-balancing binary search tree."
msgstr ""

#: ef8db26580c540cbb0da6f443c10354d of sds.tree.balanced.RedBlackTree:3
msgid ""
"A Red-Black tree is a BST with one extra bit per node: color (RED or "
"BLACK). The tree maintains balance using the following properties:"
msgstr ""

#: 91de8d8db254403580f8b1cd043672e3 of sds.tree.balanced.RedBlackTree:6
msgid "Every node is either RED or BLACK"
msgstr ""

#: d7528129bbdb4a56a4bd2c8355f0d9df of sds.tree.balanced.RedBlackTree:7
msgid "The root is always BLACK"
msgstr ""

#: ddb59f34eea44690a7d4d760d8a81c66 of sds.tree.balanced.RedBlackTree:8
msgid "All leaves (NIL) are BLACK"
msgstr ""

#: 9e240c37cbff4c47be14e0c2bea91f9d of sds.tree.balanced.RedBlackTree:9
msgid "RED nodes cannot have RED children (no two RED nodes in a row)"
msgstr ""

#: bbdbd86a51a34f69871f2b32a60cdf4e of sds.tree.balanced.RedBlackTree:10
msgid "Every path from root to leaf has the same number of BLACK nodes"
msgstr ""

#: b2f0bc76a08d4b24914f2780de0f63d8 of sds.tree.balanced.RedBlackTree:12
msgid ""
"These properties ensure the tree remains approximately balanced, "
"guaranteeing O(log n) operations."
msgstr ""

#: 5b307e669be84cec9d7532d1e4dca3e8 of sds.tree.balanced.RedBlackTree:17
msgid "The root node of the tree."
msgstr ""

#: 1d224dd4f93748b2aeb7b6d336095a9a 7fca183ca4c54bc19f4a1c658948e0bf of
#: sds.tree.balanced.RedBlackTree
msgid "type"
msgstr ""

#: b059830b2caa4a91a0df3b45d2cc8776 of sds.tree.balanced.RedBlackTree:19
msgid "RedBlackNode or None"
msgstr ""

#: 01a0e467d181452d81690baed09d8c66 of sds.tree.balanced.RedBlackTree:23
msgid "The number of nodes in the tree."
msgstr ""

#: dea53b3568a548c7863e543a04f6f157 of sds.tree.balanced.RedBlackTree:25
