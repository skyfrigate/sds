#: 03e7a82795a94b64b8d08f387d3f57cd of sds.tree.node.BTreeNode:3
msgid ""
"A B-Tree node contains multiple keys and children. For a node with k "
"keys, there are k+1 children. Keys and children maintain the B-Tree "
"ordering:"
msgstr ""

#: 70a8211c33fb439eb6877132a1d676a1 of sds.tree.node.BTreeNode:6
msgid "child[0] < key[0] < child[1] < key[1] < ... < key[k-1] < child[k]"
msgstr ""

#: b05194670b444219b4771c67b0d6c68d of sds.tree.node.BTreeNode:8
msgid ""
"In a B-Tree of minimum degree t: - Every node (except root) has at least "
"t-1 keys - Every node has at most 2t-1 keys - A node with k keys has k+1 "
"children (if not a leaf) - All leaves are at the same depth"
msgstr ""

