#: 7a818444e5ea46fbb9a2cb63e91efbbc of sds.tree.general.Tree:3
msgid ""
"A general tree is a tree structure where each node can have any number of"
" children (0 to n). This is the most flexible tree structure and is used "
"for hierarchical data like file systems, organizational charts, and "
"XML/HTML documents."
msgstr ""

#: 63e9e4f910c14695a6c1e0e23855ff35 of sds.tree.general.Tree:8
msgid ""
