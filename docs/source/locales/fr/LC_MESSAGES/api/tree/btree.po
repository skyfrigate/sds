#: 2338048810614d5abcb46c4f6a105cd4 of sds.tree.btree.BTree:3
msgid ""
"A B-Tree is a self-balancing search tree where each node can contain "
"multiple keys and have multiple children. It maintains the following "
"properties:"
msgstr ""

#: 65ac674fdb9d4d4e958fa576eca56078 of sds.tree.btree.BTree:7
msgid "Every node has at most 2t-1 keys"
msgstr ""

#: 9e5a6fb12bcd4cc987c835c4d7a0c911 of sds.tree.btree.BTree:8
msgid "Every non-leaf node has at least t-1 keys (except root)"
msgstr ""

#: aa7607b98c0749b6af428116dfba4c6a of sds.tree.btree.BTree:9
msgid "Root has at least 1 key (if tree is non-empty)"
msgstr ""

#: d4810fc840e14dadb7ad43ec00bb38d2 of sds.tree.btree.BTree:10
msgid "All leaves are at the same depth"
msgstr ""

#: b06a538915784e5c964890ad14d98959 of sds.tree.btree.BTree:11
msgid "A non-leaf node with k keys has k+1 children"
msgstr ""

#: 9084d87589534b01b2611bbb0674719f of sds.tree.btree.BTree:12
msgid "Keys in each node are in ascending order"
msgstr ""

