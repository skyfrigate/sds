#: 96f621950e5a43099c2c18d01dfb9e2a
msgid "Graph Representation"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:51
#: 9b068e85101c400a863351a21e05ef33
msgid "A graph :math:`G = (V, E)` consists of:"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:53
#: 51992c3a954540488266b2a59bf670f6
#, python-brace-format
msgid ""
"**Vertex set** :math:`V`: set of nodes :math:`\\{v_1, v_2, \\ldots, "
"v_n\\}`"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:54
#: 213fb3ac0eb94e048955adae1a2bfd74
#, python-brace-format
msgid ""
"**Edge set** :math:`E`: set of edges :math:`\\{e_1, e_2, \\ldots, e_m\\}`"
" where each :math:`e_i = (v_j, v_k)`"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:56
#: ee0a940eb0cd454980da6afeb682813c
msgid "For an **undirected graph**: :math:`(u, v) \\in E \\iff (v, u) \\in E`"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:58
#: e65e13cd8a5243baad6478c9f54e5fe8
msgid ""
"For a **directed graph**: :math:`(u, v) \\in E \\not\\Rightarrow (v, u) "
"\\in E`"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:61
#: 179477d654d14d0bb56d1933373d6be7
msgid "Adjacency List Representation"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:63
#: cafab7af8f9f4a59bb31b626105a03c0
msgid "An **adjacency list** is a collection of lists, one per vertex:"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:65
#: e01c1b54fbd94836b31d97510037189d
#, python-brace-format
msgid "Adj[v] = \\{u \\in V : (v, u) \\in E\\}"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:69
#: b1a8a20033b14bb5b52e3f0612b7f65f
msgid ""
"For each vertex :math:`v`, :math:`Adj[v]` contains all vertices adjacent "
"to :math:`v`."
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:71
#: e141ef5fe7a74d5883af99f8363a5027
#, python-brace-format
msgid "**Example**: Graph with edges :math:`\\{(A, B), (A, C), (B, C), (B, D)\\}`"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:73
#: 218d1bd88b4048ea9883864c4805adc6
#, python-brace-format
msgid ""
"\\begin{aligned}\n"
"Adj[A] &= \\{B, C\\} \\\\\n"
"Adj[B] &= \\{A, C, D\\} \\\\\n"
"Adj[C] &= \\{A, B\\} \\\\\n"
"Adj[D] &= \\{B\\}\n"
"\\end{aligned}"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:83
#: fb85592a61f04b2ca80633734b855f67
msgid "Adjacency Matrix Representation"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:85
#: 3c7a3c9326f54ccdb96aaf3c4f37e850
msgid ""
"An **adjacency matrix** is an :math:`n \\times n` boolean matrix "
":math:`M`:"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:87
#: b25e37f083614443970ad35da86c044a
#, python-brace-format
msgid ""
"M[i][j] = \\begin{cases}\n"
"1 & \\text{if } (v_i, v_j) \\in E \\\\\n"
"0 & \\text{otherwise}\n"
"\\end{cases}"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:94
#: 01b2552ac5ca40d989ed6d2dd4dcff97
msgid ""
"For **undirected graphs**: :math:`M` is symmetric (:math:`M[i][j] = "
"M[j][i]`)"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:96
#: c8728d30a9654f2d9a873fea6ec1ed1e
msgid "For **directed graphs**: :math:`M` may not be symmetric"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:98
#: 7b8242ddf7364426975da632ae0528e6
msgid ""
"For **weighted graphs**: :math:`M[i][j]` stores the edge weight instead "
"of 1"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:100
#: 4e16088bd9414a50999e5b877dbc17e5
msgid ""
"**Example**: Same graph as above with nodes indexed :math:`A=0, B=1, C=2,"
" D=3`"
msgstr ""

#: ../../source/guide/graph_structures/adjacency.rst:102
#: 7f22e0c79e9a44b8949bcf14d525fc2e
#, python-brace-format
msgid ""
"M = \\begin{bmatrix}\n"
"0 & 1 & 1 & 0 \\\\\n"
"1 & 0 & 1 & 1 \\\\\n"
"1 & 1 & 0 & 0 \\\\\n"
"0 & 1 & 0 & 0\n"
"\\end{bmatrix}"
msgstr ""

