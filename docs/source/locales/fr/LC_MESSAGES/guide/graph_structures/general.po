#: ../../source/guide/graph_structures/general.rst:186
#: 6e1d7c730ac54939a4e8a38a2df212a1
#, python-brace-format
msgid ""
"A[i][j] = \\begin{cases}\n"
"1 & \\text{if } \\{v_i, v_j\\} \\in E \\\\\n"
"0 & \\text{otherwise}\n"
"\\end{cases}"
