#: ../../source/guide/graph_structures/directed.rst:72
#: a36563c3bafa4cc0898c337449203f74
msgid "Directed Edge Properties"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:74
#: 49abff46748d46d9b11e6fcd1e63970c
msgid "For an edge :math:`e = (u, v)`:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:76
#: a723abb28a51409d97d86fdd9831abd8
#, python-brace-format
msgid ""
"\\begin{aligned}\n"
"\\text{source}(e) &= u \\\\\n"
"\\text{target}(e) &= v \\\\\n"
"\\text{reverse}(e) &= (v, u)\n"
"\\end{aligned}"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:84
#: 0a4b1b5478354f7c8615239288b1b07b
msgid ""
"An edge :math:`(u, v)` is an **outgoing edge** from :math:`u` and an "
"**incoming edge** to :math:`v`."
msgstr ""

