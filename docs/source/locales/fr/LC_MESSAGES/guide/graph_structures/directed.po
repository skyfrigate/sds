#: c6d6c44443624b19a03bb8cbdd4e677f
msgid "Paths in Directed Graphs"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:139
#: 9fb58a814f5f442997cf6c670acc620f
msgid "Directed Path"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:141
#: b3cb2360df7845168ce4ee1b6f4a68c1
msgid "A **directed path** from :math:`u` to :math:`v` is a sequence:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:143
#: 3d3adeab7cb540ae928cc29c36d1b64f
#, python-brace-format
msgid ""
"P = (v_0, v_1, \\ldots, v_k) \\text{ where } (v_i, v_{i+1}) \\in E "
"\\text{ for all } i"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:147
#: f389d32d226f497ab9ed1b114eee9560
msgid ":math:`v_0 = u` is the start, :math:`v_k = v` is the end."
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:149
#: d99ea89f125042b18efc461a67bdb860
msgid "**Path length**: :math:`k` (number of edges)"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:152
#: ../../source/guide/graph_structures/directed.rst:449
#: 334673655c0447f28bb48d9ca2dd692b 3f06cceacae3437dbf9896fef62f1151
msgid "Reachability"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:154
#: b1dba58062a147a69afb1a2ece3afaea
msgid ""
"Vertex :math:`v` is **reachable** from :math:`u` if there exists a "
"directed path from :math:`u` to :math:`v`:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:156
#: cee9a26b5dd6414b83b55b0038400801
#, python-brace-format
msgid ""
"v \\text{ reachable from } u \\iff \\exists \\text{ directed path } u "
"\\rightsquigarrow v"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:161
#: fe418da006924a389cdc395d8da57c3f
msgid "Cycles in Directed Graphs"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:164
#: cb7fe83c344c41d99dc2bbd6d61f8f9e
msgid "Directed Cycle"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:166
#: 05984dfc23184fcfa7a9906f65e240fb
msgid "A **directed cycle** is a path :math:`C = (v_0, v_1, \\ldots, v_k)` where:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:168
#: c2b4ac885f4445da9503a9fab505f2c7
#, python-brace-format
msgid "v_0 = v_k \\text{ and } k \\geq 1"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:172
#: 4a7d0b1302a641379af65c187382051a
msgid "**Simple cycle**: All vertices except :math:`v_0 = v_k` are distinct."
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:175
#: 9ddda1e4c9d8455b9e96b2dc7e58330d
msgid "Directed Acyclic Graph (DAG)"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:177
#: 1ae643aee3fc45018d8eadd88632ba2c
msgid "A **DAG** is a directed graph with **no directed cycles**:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:179
#: 00cb753e9fd549c383c33509f5534622
#, python-brace-format
msgid "\\text{DAG} \\iff \\nexists \\text{ directed cycle in } G"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:183
#: 64858249c00543a5b26f71d70977b190
msgid "**Key property**: DAGs can be **topologically sorted**."
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:186
#: 32ece28de5b348e4bfdf3a6f116eccd8
msgid "Topological Ordering"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:188
#: cdb62060fce849a2b0d60e699b54a695
msgid ""
"A **topological ordering** of a DAG :math:`G = (V, E)` is a linear "
"ordering of vertices:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:190
#: 95cdd7c22f8e43b7bb1bab30a71c852f
msgid "v_1, v_2, \\ldots, v_n"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:194
#: 415feddc1c02417aa8eb8564bb115f03
msgid "such that:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:196
#: 315a81a81fa04f72a5d3ff36cb99d708
msgid "(v_i, v_j) \\in E \\implies i < j"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:200
#: 1716c0863c034e47b51960b68a30ccbe
msgid "Every DAG has at least one topological ordering."
msgstr ""

