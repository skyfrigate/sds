#: b4d27fb5b54849788bdcc1437481f816
msgid "Degree in Directed Graphs"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:90
#: a62638963b6e4cc1b9b95a455b7fb680
msgid "In-Degree and Out-Degree"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:92
#: 852d327a4a44422b92a5a8872b120f17
msgid "**Out-degree** of vertex :math:`v`:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:94
#: d3119c6f7b06411a8c1555d23fb1b75e
#, python-brace-format
msgid "deg^{out}(v) = |\\{u \\in V : (v, u) \\in E\\}|"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:98
#: eb3676df12f440e696f7c83bc9b79b9b
msgid "Number of edges **leaving** :math:`v`."
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:100
#: eab36a0162ee45ad937353ba99095307
msgid "**In-degree** of vertex :math:`v`:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:102
#: b3f3310531574852b2f773a421f6da50
#, python-brace-format
msgid "deg^{in}(v) = |\\{u \\in V : (u, v) \\in E\\}|"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:106
#: fd1a1e08815a4033bb507ec06ca5f716
msgid "Number of edges **entering** :math:`v`."
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:108
#: 09772bf32ddb4e3b8da141cdfbb10b46
msgid "**Total degree**:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:110
#: 0c6b9b4c80c644dc9808643ebccd2552
#, python-brace-format
msgid "deg(v) = deg^{in}(v) + deg^{out}(v)"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:115
#: 1399b507bdba4db396c57badc82c409d
msgid "Degree Sum Properties"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:117
#: 6dba04312c1347b8826b332c807357c1
msgid "**Out-degree sum**:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:119
#: c4462d67c0aa40d6ac788d12d367568a
#, python-brace-format
msgid "\\sum_{v \\in V} deg^{out}(v) = |E|"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:123
#: 91771499610d49fe95ac49511d27bfc3
msgid "**In-degree sum**:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:125
#: a769d2d9b4a14efb8802471f1079a4a3
#, python-brace-format
msgid "\\sum_{v \\in V} deg^{in}(v) = |E|"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:129
#: 4c5066ffc75245eb8beab51c4432f4a7
msgid "**Total degree sum**:"
msgstr ""

#: ../../source/guide/graph_structures/directed.rst:131
#: a4caf0b87e1c4d97a9bba9adc840febc
#, python-brace-format
msgid "\\sum_{v \\in V} deg(v) = 2|E|"
msgstr ""

