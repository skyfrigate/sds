#: ../../source/guide/graph_structures/weighted.rst:71
#: bf6598bcea9b4d6d862a045f6932bce7
msgid "for directed graphs"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:73
#: 423dd1281c804ca4a633a473c2b2809a
msgid "**Weight function** :math:`w`: maps edges to real numbers"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:75
#: b733b634a38242fdafa47c21c97a14ba
#, python-brace-format
msgid "w: E \\rightarrow \\mathbb{R}"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:79
