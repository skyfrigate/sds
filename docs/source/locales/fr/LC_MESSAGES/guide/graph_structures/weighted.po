msgid "Minimum Spanning Tree"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:156
#: d379e4dc5c1e47b59af47f4ce776a797
msgid ""
"For a connected weighted undirected graph, a **minimum spanning tree "
"(MST)** :math:`T` is a spanning tree such that:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:158
#: d9cd131f0275452492b8d508a2a28e74
#, python-brace-format
msgid "w(T) = \\sum_{e \\in T} w(e)"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:162
#: 87e533032ffc4168ba0e080818b363f4
msgid "is minimized among all spanning trees."
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:164
#: 519eef478d9c4b37ba8b6063e926dc16
msgid "**Properties of MST:**"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:166
#: e7a0bca070b04ea1bb40b86163c0b5c4
msgid "**Uniqueness**: MST is unique if all edge weights are distinct"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:167
#: 467f44dade2941229021ab340df56e0f
msgid "**Cut property**: Minimum weight edge crossing a cut is in some MST"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:168
#: 8553860083f34a6b8230663e93eee0ff
msgid "**Cycle property**: Maximum weight edge in any cycle is not in any MST"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:171
#: e5ca687a988a4ca399e96e2d1baa468f
msgid "Weighted Degree"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:173
#: 2cb842c82494403a9870f0606efbf59a
msgid "The **weighted degree** of a vertex :math:`v`:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:175
#: 273dba15db864448ba60366a301272dc
msgid "deg_w(v) = \\sum_{\\{v,u\\} \\in E} w(\\{v, u\\})"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:179
#: a38aba8a003e44b0b4c019c0868fda8f
msgid "For directed graphs:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:181
#: 7ec98fb6e65c49bcbf9c7cbe1c1ce11b
#, python-brace-format
msgid ""
"\\begin{aligned}\n"
"deg_w^{in}(v) &= \\sum_{(u,v) \\in E} w((u, v)) \\\\\n"
"deg_w^{out}(v) &= \\sum_{(v,u) \\in E} w((v, u))\n"
"\\end{aligned}"
msgstr ""

