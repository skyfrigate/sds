#: ../../source/guide/graph_structures/weighted.rst:86
#: d4bf73bd4cbf47d6afb9256cd7e5f779
#, python-brace-format
msgid "w(e) \\in \\mathbb{R}"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:90
#: abd29ba3d01b47a99e628ec0ec4ae7c9
msgid "**Common weight interpretations:**"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:92
#: 2bdc462594c54fcb87b1b73ad3fb3639
msgid "**Distance**: :math:`w(e) \\geq 0` (non-negative)"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:93
#: 22b46db9d5e04a60b5a735cb54e48aa4
msgid "**Cost**: :math:`w(e) \\geq 0` typically"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:94
#: c2d11b5835e7456a817278216d0b6184
msgid "**Capacity**: :math:`w(e) > 0` (positive)"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:95
#: 349e895183834406b8c01a6da5fdc59b
msgid "**Profit**: :math:`w(e)` can be negative"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:96
#: 09add34744464450aae445d68867a060
msgid "**Time**: :math:`w(e) \\geq 0` usually"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:99
#: c63916fef7024226b264b2cf2504e948
msgid "Graph Properties"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:102
#: 58edbe08836a464690d27e0840fb2aa9
msgid "Total Weight"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:104
#: ddc9d171e5284f3a99331fdfdeaf3ba4
msgid "The **total weight** of a graph is the sum of all edge weights:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:106
#: 1b47a3351cef4aada44f54d0aca915cc
#, python-brace-format
msgid "W(G) = \\sum_{e \\in E} w(e)"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:111
#: 0c2455c627a94e2b94fa7182ddc57b81
msgid "Path Weight"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:113
#: 50874c5e174246958bab5e9fce782bdc
msgid "For a path :math:`P = (v_1, v_2, \\ldots, v_k)`:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:115
#: aede5bde3bcc433ebb47a5ca009dfc51
msgid "w(P) = \\sum_{i=1}^{k-1} w(\\{v_i, v_{i+1}\\})"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:119
#: 1f9d021b36c0446aacd63c8aa025d3cb
msgid "or for directed paths:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:121
#: ade59974baa748f8a358859f2d65d491
#, python-brace-format
msgid "w(P) = \\sum_{i=1}^{k-1} w((v_i, v_{i+1}))"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:126
#: 6c26015c86ca41409dabdbc171fe948e
msgid "Shortest Path"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:128
#: 444b9d0b78d244b2bcd9957890f8f0f2
msgid "The **shortest path** from :math:`u` to :math:`v` is:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:130
#: a6f1550ab85647479aaca984984d8f0d
#, python-brace-format
msgid ""
"\\delta(u, v) = \\min\\{w(P) : P \\text{ is a path from } u \\text{ to } "
"v\\}"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:134
#: 9e1277be94484c92985632f8cf4a9a1b
msgid "If no path exists:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:136
#: 622cf956ee464ff19597353f817f4537
msgid "\\delta(u, v) = \\infty"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:141
#: 7fb8eb1d54224d36ab070f858640ba3e
msgid "Distance Matrix"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:143
#: 053c5d78dd8c4243a9ad2c7d939a2de7
msgid "For a graph with :math:`n` vertices, the **distance matrix** :math:`D` is:"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:145
#: 29d4a0ac3ad94aae8fa651d418f2245c
#, python-brace-format
msgid ""
"D_{ij} = \\begin{cases}\n"
"0 & \\text{if } i = j \\\\\n"
"w(\\{v_i, v_j\\}) & \\text{if } \\{v_i, v_j\\} \\in E \\\\\n"
"\\infty & \\text{otherwise}\n"
"\\end{cases}"
msgstr ""

#: ../../source/guide/graph_structures/weighted.rst:154
