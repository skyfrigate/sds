msgid ""
"remove\\_first(\\langle n_1, n_2, \\ldots, n_k \\rangle) = (n_1.data, "
"\\langle n_2, \\ldots, n_k \\rangle)"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:206
#: 9dcb5ca0e71d4f6d8e2614653a54a86c
msgid "**Remove last:**"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:208
#: 3aed2b5e8595470290077fb48bffe228
#, python-brace-format
msgid ""
"remove\\_last(\\langle n_1, \\ldots, n_{k-1}, n_k \\rangle) = (n_k.data, "
"\\langle n_1, \\ldots, n_{k-1} \\rangle)"
msgstr ""

