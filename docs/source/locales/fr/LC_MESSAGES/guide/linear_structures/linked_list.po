#: ../../source/guide/linear_structures/linked_list.rst:73
#: 1287213b98fc48dc86108480350f9d03
msgid "**Extra memory**: Two pointers per node"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:74
#: 4c7fab01e7a149b1a9c31c8a8867af37
msgid "**Efficient operations at both ends**: O(1) prepend and append"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:75
#: 28212a80066f4405b1d6cc05a6ebf86d
msgid "**Remove from tail**: O(1) (unlike singly linked)"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:76
#: 734b56d351ea47b3bb6b70870bc06a04
msgid "**Best for**: Deques, LRU cache, undo/redo systems"
msgstr ""

