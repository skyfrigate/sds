#: ../../source/guide/linear_structures/linked_list.rst:193
#: f4097dc30b834f94b6fc287559240927
#, python-brace-format
msgid ""
"insert\\_at(L, i, x) = \\langle n_1, \\ldots, n_{i-1}, n_{new}, n_i, "
"\\ldots, n_k \\rangle"
msgstr ""

