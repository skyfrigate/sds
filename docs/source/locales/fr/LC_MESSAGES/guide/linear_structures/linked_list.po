msgid "**Characteristics:**"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:43
#: dde61a4a7fe644feb888f239df46cd83
msgid "**Memory efficient**: Only one pointer per node"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:44
#: 88c0ff14f179424dad3cef7067abc9c7
msgid "**Forward traversal only**: Cannot move backward"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:45
#: 5cacff323f7c41c39f243b34c509c88a
msgid "**Prepend**: O(1) - efficient insertion at head"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:46
#: 4de03d02c54140a1be6e664fc55080a5
msgid "**Append**: O(n) without tail pointer, O(1) with tail pointer"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:47
#: 5e65426ee848425f85e72f9df55c493c
msgid "**Best for**: Stacks, forward-only iteration"
msgstr ""

