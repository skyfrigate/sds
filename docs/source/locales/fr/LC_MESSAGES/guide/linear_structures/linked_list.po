msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:177
#: 21d314f0c8a94cb181294513a4deb576
#, python-brace-format
msgid "prepend(L, x) = \\langle n_{new}, n_1, n_2, \\ldots, n_k \\rangle"
msgstr ""

#: ../../source/guide/linear_structures/linked_list.rst:181
#: b43b2c4ead15481e8525e081ccd1056e
#, python-brace-format
msgid "where :math:`n_{new}.data = x` and :math:`n_{new}.next = n_1`"
