msgid "Formal Definition"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:42
#: d7d607f4ba7b4838b1b47fa6a5ccd903
msgid ""
"A stack :math:`S` can be formally defined as an ordered collection with "
"the following properties:"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:44
#: 6ae05aed43d74be9bc7410643eb84ae9
msgid "S = \\langle e_1, e_2, \\ldots, e_n \\rangle"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:48
#: a5fa3bc3f24a4f54a3cd08cc14e76e73
msgid ""
"where :math:`e_n` is the **top** element (most recently added) and "
":math:`e_1` is the **bottom** element (first added)."
msgstr ""

