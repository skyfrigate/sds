#: ../../source/guide/linear_structures/stack.rst:74
#: e63143f342b746f0bb7e9795953d1b43
#, python-brace-format
msgid ""
"pop(\\langle e_1, e_2, \\ldots, e_n \\rangle) = (e_n, \\langle e_1, e_2, "
"\\ldots, e_{n-1} \\rangle)"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:80
#: 4a00e2902b7546edba4f17dd2d1fdb60
msgid "Returns both the element and the modified stack"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:81
#: 41df8fc417f54ee8a73f59a174303979
msgid "Undefined for empty stack: :math:`pop(\\emptyset)` raises error"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:82
#: 3c2626ae53e54b0dad1af334697eed00
msgid "The size decreases: :math:`|S'| = |S| - 1`"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:85
#: d059313163bf4e6891edc5563fb30286
msgid "Peek Operation"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:87
#: 99f1e3a4103044ec847ae3e602832c71
msgid "The peek operation returns the top element without removing it:"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:89
#: 2f43b25bb94942f9b8b7fb558d5241cd
msgid "peek(\\langle e_1, e_2, \\ldots, e_n \\rangle) = e_n"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:95
#: 126f47d198b54070ba697f669e29275c
msgid ""
"Non-destructive: :math:`peek(S) \\rightarrow e_n` where :math:`S` "
"unchanged"
