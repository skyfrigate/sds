#: ../../source/guide/linear_structures/stack.rst:56
#: e3263c35d4ec441da7f72d44f6706aa5
msgid "The push operation adds an element to the top of the stack:"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:58
#: c85a742342094ddcb48266bf8b940264
msgid "push(S, x) = \\langle e_1, e_2, \\ldots, e_n, x \\rangle"
msgstr ""

#: ../../source/guide/linear_structures/stack.rst:62
#: 755fbc6ae5be45daad55ce834da68c0d
msgid "where :math:`x` becomes the new top element."
msgstr ""

