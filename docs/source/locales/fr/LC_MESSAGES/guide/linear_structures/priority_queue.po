#: ../../source/guide/linear_structures/priority_queue.rst:51
#: 92555be77c584f8a8c4d293d026640d3
#, python-brace-format
msgid "PQ = \\{(e_1, p_1), (e_2, p_2), \\ldots, (e_n, p_n)\\}"
msgstr ""

#: ../../source/guide/linear_structures/priority_queue.rst:55
#: 1a7026c6a72141caa11167c69bed8eef
#, python-brace-format
msgid ""
"where each element :math:`e_i` has an associated priority :math:`p_i \\in"
" \\mathbb{R}`."
msgstr ""

#: ../../source/guide/linear_structures/priority_queue.rst:58
#: 5480b9e385084fff8b1ecb6739ae39ac
msgid "Priority Ordering"
msgstr ""

#: ../../source/guide/linear_structures/priority_queue.rst:60
#: 7cbc52e001f64259b453d90d20c7caca
msgid "Elements are ordered by priority, not insertion order:"
