msgid "Deque Extensions"
msgstr ""

#: ../../source/guide/linear_structures/queue.rst:89
#: 7946ba9c224145f4a2992abe96887484
msgid "A **deque** (double-ended queue) allows operations at both ends:"
msgstr ""

#: ../../source/guide/linear_structures/queue.rst:91
#: 7f77649504a547c6b347a153babcbaa2
#, python-brace-format
msgid ""
"\\begin{align*}\n"
"add\\_front(Q, x) &= \\langle x, e_1, e_2, \\ldots, e_n \\rangle \\\\\n"
"add\\_rear(Q, x) &= \\langle e_1, e_2, \\ldots, e_n, x \\rangle \\\\\n"
"remove\\_front(Q) &= (e_1, \\langle e_2, \\ldots, e_n \\rangle) \\\\\n"
"remove\\_rear(Q) &= (e_n, \\langle e_1, \\ldots, e_{n-1} \\rangle)\n"
"\\end{align*}"
msgstr ""

