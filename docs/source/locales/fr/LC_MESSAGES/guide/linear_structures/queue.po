#: ../../source/guide/linear_structures/queue.rst:41
#: e4b7d731893147199cbec103cc938e3b
msgid "A queue :math:`Q` is an ordered collection:"
msgstr ""

#: ../../source/guide/linear_structures/queue.rst:43
#: 195b92e37b164b0e8cca88a8d78b7b7f
msgid "Q = \\langle e_1, e_2, \\ldots, e_n \\rangle"
msgstr ""

#: ../../source/guide/linear_structures/queue.rst:47
#: a82cebc876744fd8a2e2358e9640e6d0
msgid ""
"where :math:`e_1` is the **front** element (oldest, will be removed next)"
" and :math:`e_n` is the **rear** element (newest, just added)."
msgstr ""

