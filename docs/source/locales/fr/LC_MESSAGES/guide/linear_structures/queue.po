#: ../../source/guide/linear_structures/queue.rst:105
#: c5bfe502fb034716b9aced89085d6c93
#, python-brace-format
msgid ""
"dequeue(PQ) = (e_i, PQ \\setminus \\{e_i\\}) \\text{ where } "
"priority(e_i) = \\max_{e \\in PQ} priority(e)"
msgstr ""

