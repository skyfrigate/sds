#: ../../source/guide/tree_structures/general.rst:106
#: 2c313d7bbb8a41bba7b93b4acdda0c7d
#, python-brace-format
msgid ""
"depth(v) = \\begin{cases}\n"
"0 & \\text{if } v = root \\\\\n"
"depth(\\text{parent}(v)) + 1 & \\text{otherwise}\n"
"\\end{cases}"
msgstr ""

#: ../../source/guide/tree_structures/general.rst:113
#: bce92f017a3a4224a5318f91ad6eddfb
msgid "**Height of a node** :math:`v`:"
msgstr ""

#: ../../source/guide/tree_structures/general.rst:115
#: 1a10a3786a96474dafc62715579764c6
#, python-brace-format
msgid ""
"height(v) = \\begin{cases}\n"
"0 & \\text{if } v \\text{ is a leaf} \\\\\n"
"1 + \\max_{c \\in children(v)} height(c) & \\text{otherwise}\n"
"\\end{cases}"
msgstr ""

#: ../../source/guide/tree_structures/general.rst:122
#: db255a53cffd4f738abb7f97601e895a
msgid "**Height of the tree:**"
msgstr ""

#: ../../source/guide/tree_structures/general.rst:124
