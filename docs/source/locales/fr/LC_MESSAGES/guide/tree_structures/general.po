#: d6383c0240c548ea9fc82774c2485cef
#, python-brace-format
msgid ""
"leaves(T) = \\begin{cases}\n"
"1 & \\text{if } degree(root) = 0 \\\\\n"
"\\sum_{i=1}^{k} leaves(T_i) & \\text{otherwise}\n"
"\\end{cases}"
