#: a9fda558d9824741980dd53f566e353f
#, python-brace-format
msgid ""
"d(v) = \\begin{cases}\n"
"0 & \\text{if } v = root \\\\\n"
"1 + d(parent(v)) & \\text{otherwise}\n"
"\\end{cases}"
