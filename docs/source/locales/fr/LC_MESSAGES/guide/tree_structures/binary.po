"\\forall x \\in T_L: x.data < node.data \\\\\n"
"\\forall y \\in T_R: y.data > node.data \\\\\n"
"T_L \\text{ and } T_R \\text{ are BSTs}\n"
"\\end{cases}"
msgstr ""

