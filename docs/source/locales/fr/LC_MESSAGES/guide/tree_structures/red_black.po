#: ../../source/guide/tree_structures/red_black.rst:53
#: c078bede64e745eba0f486aebcf6f4ec
msgid "A Red-Black tree is a BST that satisfies five properties:"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:55
#: 052f2928bfd9458cbfe9b1deeff34157
msgid "**Color Property**: Every node is either RED or BLACK"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:57
#: 80d4b50b76314b7f9ba62212b4eb6f10
msgid "\\forall node \\in T: color(node) \\in \\{\\text{RED}, \\text{BLACK}\\}"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:61
#: 963c41b136de478e8ffa6528139553e7
msgid "**Root Property**: The root is BLACK"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:63
#: 092933801b2543eba918069b0bb949d1
#, python-brace-format
msgid "color(root) = \\text{BLACK}"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:67
#: 48ed8cc36a5945f3a6bcefde5f6e2791
msgid "**Leaf Property**: All leaves (NIL nodes) are BLACK"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:69
#: eec050ca3c9243ac959928b65c44d0bf
#, python-brace-format
msgid "color(NIL) = \\text{BLACK}"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:73
#: 8d20435a717a42f893386391f554b69a
msgid "**Red Property**: If a node is RED, both children are BLACK"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:75
#: 4bc111dffed54644aad031c6fb5fa143
#, python-brace-format
msgid ""
"color(node) = \\text{RED} \\implies color(node.left) = color(node.right) "
"= \\text{BLACK}"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:79
#: 746330af298f419fb412f600139cc66c
msgid ""
"**Black-Height Property**: All paths from a node to descendant leaves "
"contain the same number of BLACK nodes"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:81
#: 3de91b008f5e4333b25dc40a9d122c85
#, python-brace-format
msgid ""
"\\forall node \\in T: bh(\\text{all paths from node to leaves}) = "
"\\text{constant}"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:86
#: a344ecb65c9f4dd9ba92d63073b4d6e0
msgid "Black-Height Definition"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:88
#: a7df6743e1e84c598cabf07530823f43
msgid ""
"The **black-height** :math:`bh(node)` of a node is the number of BLACK "
"nodes on any path from (but not including) the node to a leaf:"
msgstr ""

#: ../../source/guide/tree_structures/red_black.rst:90
#: 751e364e6cee415da4aa94c490f29f39
#, python-brace-format
msgid ""
"bh(node) = \\begin{cases}\n"
"0 & \\text{if } node = NIL \\\\\n"
"bh(child) & \\text{if } color(node) = \\text{RED} \\\\\n"
"bh(child) + 1 & \\text{if } color(node) = \\text{BLACK}\n"
"\\end{cases}"
msgstr ""

