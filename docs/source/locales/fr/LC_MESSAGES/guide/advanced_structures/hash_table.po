msgstr ""

#: ../../source/guide/advanced_structures/hash_table.rst:24
#: 27d87923ce63479ebaa8867058bc4ddf
msgid ""
"A hash function :math:`h : U \\to [0, m)` maps the universe of keys "
":math:`U` to :math:`m` slots. Python's built-in ``hash()`` is used "
"internally, composed with ``% m``."
msgstr ""

#: ../../source/guide/advanced_structures/hash_table.rst:29
#: 95eae13ca2e9439d9f6c64d41640d2a1
msgid "Load Factor"
msgstr ""

#: ../../source/guide/advanced_structures/hash_table.rst:31
#: 6402ee29893d42dbb62a39367a132a6c
#, python-brace-format
msgid "\\alpha = \\frac{n}{m}"
msgstr ""

#: ../../source/guide/advanced_structures/hash_table.rst:35
#: c9f2c0deb9c54953933c93f2170366f1
msgid ""
"where :math:`n` = stored entries, :math:`m` = capacity. Higher "
":math:`\\alpha` increases the probability of collision."
msgstr ""

