#: ../../source/guide/advanced_structures/skip_list.rst:50
#: e4f8a1f10f8848568ef5ab385ec8d5ea
#, python-brace-format
msgid "Expected height: :math:`E[L] = O(\\log_{1/p} n)`"
msgstr ""

#: ../../source/guide/advanced_structures/skip_list.rst:51
#: 73ef05b7b51c45eda7644613cb6394e3
msgid ""
"Expected space: :math:`O(n / (1-p))` — i.e. :math:`O(2n)` for :math:`p = "
"0.5`"
