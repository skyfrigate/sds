#: ../../source/guide/advanced_structures/skip_list.rst:25
#: 4227597c940448829b88895cc08a5960
msgid ""
"A Skip List of maximum height :math:`L` is a family of linked lists "
":math:`S_0 \\supseteq S_1 \\supseteq \\cdots \\supseteq S_L` where:"
msgstr ""

#: ../../source/guide/advanced_structures/skip_list.rst:28
#: add1cbff8ded46ee8cc93e8e4ec28186
msgid ":math:`S_0` — base list containing all elements (sorted)"
msgstr ""

#: ../../source/guide/advanced_structures/skip_list.rst:29
#: bba687f91696481985c743128a8d8c55
#, python-brace-format
msgid ""
":math:`S_i` — subset of :math:`S_{i-1}`; each element is promoted with "
"probability :math:`p`"
msgstr ""

