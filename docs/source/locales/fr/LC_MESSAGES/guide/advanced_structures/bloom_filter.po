#: ../../source/guide/advanced_structures/bloom_filter.rst:14
#: 719ed0edf4f44fb98187d80a37c9d081
msgid ""
"A **Bloom Filter** is a space-efficient probabilistic data structure that"
" tests whether an element is a member of a set. It stores only a compact "
"bit array and guarantees:"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:18
#: 717ed5d06a664945b06b6939d6b0adbf
msgid "**No false negatives**: if ``x not in bf``, *x* is definitely absent."
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:19
#: 29964d682d3343d1a0576746549ccb3b
msgid ""
"**Possible false positives**: if ``x in bf``, *x* is *probably* (but not "
"certainly) present."
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:23
#: e27d42be2be046678566e824a68bf960
msgid "Mathematical Foundations"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:26
#: 933e69008a0f4a36a2f91ba5ef3ccb27
msgid "Formal Definition"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:28
#: bbd88fd41db141728dc23a20357f242d
msgid "A Bloom Filter for universe :math:`U` is a triple :math:`(m, k, h)` where:"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:30
#: b64777adc5d042b4aada79baaef3fb87
msgid ":math:`m` — size of the bit array"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:31
#: 43e37798881a42d098c9dfc24e4b04f4
msgid ""
":math:`k` — number of hash functions :math:`h_1, \\ldots, h_k : U \\to "
"[0, m)`"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:32
#: 0ea10536e5cb4907a64065dc0c5efbf9
msgid "A bit array :math:`B[0..m-1]`, initialised to 0"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:34
#: a61482d26cbf46e980e812881e5b3437
msgid "**Insert** :math:`x \\in U`:"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:36
#: 529ec012d76f474da43e0fae8c5703f7
msgid "\\forall i \\in [1, k] : B[h_i(x)] \\leftarrow 1"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:40
#: 379524922b18463894c24819ca1c249c
msgid "**Test** membership of :math:`x`:"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:42
#: da46d98022464f1286804173670cacc1
msgid "x \\in S \\iff \\forall i \\in [1, k] : B[h_i(x)] = 1"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:47
#: f9c935a4f72b41dc88c82661129922a0
msgid "False Positive Rate"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:49
#: 4420bcca99044acf99201201fbcb97b1
msgid ""
"For :math:`n` elements inserted into a filter of :math:`m` bits with "
":math:`k` hash functions:"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:52
#: 15210bc8e56c49b69ff9a34ec335e957
#, python-brace-format
msgid "P_{fp} \\approx \\left(1 - e^{-kn/m}\\right)^k"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:57
#: 502ed047e3ee417fae9378107c395035
msgid "Optimal Parameters"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:59
#: c33afd8d8365429ea20b25aece64be51
msgid "For :math:`n` elements and target false positive rate :math:`p`:"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:61
#: f249b6739b3e453f9cde523046c1f63c
#, python-brace-format
msgid ""
"m^* = \\left\\lceil \\frac{-n \\ln p}{(\\ln 2)^2} \\right\\rceil\n"
"\\qquad\n"
"k^* = \\left\\lfloor \\frac{m}{n} \\ln 2 \\right\\rfloor"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:68
#: 091bea42e0ef4bc6b6de92c12f08aeb9
msgid "Double Hashing"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:70
#: 95383692073f4a23b8114b2398a0657b
msgid ""
"Instead of :math:`k` independent hash functions, the implementation uses "
"**double hashing** (Kirsch & Mitzenmacher, 2006):"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:73
#: 00d0b5f6ae194f0390c188b01c639c28
msgid "h_i(x) = (h_1(x) + i \\cdot h_2(x)) \\bmod m"
msgstr ""

#: ../../source/guide/advanced_structures/bloom_filter.rst:77
#: d47c62084be742fca455659034ebcf85
msgid "where :math:`h_1` = SHA-256 and :math:`h_2` = MD5 (non-cryptographic use)."
msgstr ""

